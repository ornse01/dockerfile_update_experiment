            {
              "id": "CVE-2026-57452",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "vim: Vim: Out-of-bounds Read with libsodium-encrypted Files"
              },
              "fullDescription": {
                "text": "Vim is an open source, command line text editor. Prior to 9.2.0671, when Vim opens a file encrypted with the VimCrypt~04! or VimCrypt~05!\nmethod (xchacha20poly1305, requires the +sodium feature) whose body is shorter than a single libsodium secretstream header, an unsigned length calculation underflows and a subsequent decryption call reads far past the end of the input buffer, crashing Vim. This vulnerability is fixed in 9.2.0671."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-57452",
